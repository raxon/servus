{
  "name": "servus",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "license": "PolyForm-Noncommercial-1.0.0",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@11.19.1",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:panel": "npm run dev --workspace=@servus/panel",
    "dev:website": "npm run dev --workspace=@servus/website",
    "dev:api": "npm run dev:api --workspace=@servus/panel",
    "dev:web": "npm run dev:panel",
    "agent": "npm run agent --workspace=@servus/panel",
    "worker": "npm run worker --workspace=@servus/panel",
    "build": "turbo run build",
    "build:panel": "npm run build --workspace=@servus/panel",
    "build:website": "npm run build --workspace=@servus/website",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test && npm run test:installer && npm run test:vps-harness",
    "test:panel": "npm run test --workspace=@servus/panel",
    "test:installer": "node --test tests/install/*.test.mjs",
    "test:vps-harness": "node --test tests/vps-harness.test.mjs",
    "start": "npm run start --workspace=@servus/panel",
    "start:agent": "npm run start:agent --workspace=@servus/panel",
    "start:worker": "npm run start:worker --workspace=@servus/panel",
    "local": "npm run build:panel && node scripts/local.mjs",
    "local:vm": "bash scripts/start-local.sh",
    "prepare:website": "node scripts/prepare-website.mjs",
    "preview:website": "npm run preview --workspace=@servus/website",
    "deploy:website": "npm run build:website && wrangler deploy --config apps/website/wrangler.jsonc",
    "check:cloudflare": "npm run build:website && wrangler deploy --dry-run --config apps/website/wrangler.jsonc",
    "smoke": "tsx scripts/smoke.ts",
    "test:integration": "tsx scripts/integration.ts",
    "test:advanced": "tsx scripts/integration-advanced.ts",
    "test:parity": "tsx scripts/parity.ts",
    "test:reference-failures": "tsx scripts/reference-failures.ts",
    "test:restart": "tsx scripts/restart-check.ts",
    "fixtures:git": "node scripts/fixture-git.mjs",
    "test:access": "tsx scripts/access-check.ts",
    "test:storage": "tsx scripts/storage-check.ts",
    "report:parity": "tsx scripts/report-parity.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "tsx": "4.23.15",
    "turbo": "2.11.11",
    "wrangler": "4.162.0"
  }
}
