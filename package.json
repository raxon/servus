{
  "name": "self-hosted-panel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "PolyForm-Noncommercial-1.0.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "dev:web": "vite --host 127.0.0.1 --port 4181",
    "agent": "tsx src/agent/index.ts",
    "worker": "tsx src/worker/index.ts",
    "build": "tsc -p tsconfig.server.json && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.server.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "start": "node dist/server/index.js",
    "start:agent": "node dist/agent/index.js",
    "start:worker": "node dist/worker/index.js",
    "smoke": "tsx scripts/smoke.ts",
    "local": "npm run build && node scripts/local.mjs",
    "local:vm": "bash scripts/start-local.sh",
    "test:integration": "tsx scripts/integration.ts",
    "test:advanced": "tsx scripts/integration-advanced.ts",
    "test:parity": "tsx scripts/parity.ts",
    "test:reference-failures": "tsx scripts/reference-failures.ts",
    "test:restart": "tsx scripts/restart-check.ts",
    "fixtures:git": "node scripts/fixture-git.mjs",
    "test:access": "tsx scripts/access-check.ts",
    "test:storage": "tsx scripts/storage-check.ts",
    "report:parity": "tsx scripts/report-parity.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/rate-limit": "11.2.2",
    "@fastify/static": "10.1.11",
    "@fastify/websocket": "11.3.7",
    "@fontsource-variable/inter": "5.3.0",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-router": "1.170.46",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "better-sqlite3": "13.1.1",
    "dockerode": "5.0.1",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.8",
    "lucide-react": "1.72.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "ws": "8.23.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/dockerode": "4.0.2",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.3.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
