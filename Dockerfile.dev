FROM docker:29-cli AS docker-cli

FROM node:24-bookworm-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends python3 make g++ git openssh-client ca-certificates && rm -rf /var/lib/apt/lists/*
COPY --from=docker-cli /usr/local/bin/docker /usr/bin/docker
COPY --from=docker-cli /usr/local/libexec/docker/cli-plugins /usr/local/libexec/docker/cli-plugins
COPY package.json package-lock.json ./
COPY apps/panel/package.json ./apps/panel/package.json
COPY apps/website/package.json ./apps/website/package.json
RUN npm ci --workspace=@servus/panel --include-workspace-root=false --no-audit --no-fund
COPY apps/panel ./apps/panel
RUN npm run build --workspace=@servus/panel
ENV NODE_ENV=development PANEL_DATA_DIR=/var/lib/panel PANEL_HOST=0.0.0.0
CMD ["node_modules/.bin/tsx", "watch", "--clear-screen=false", "--inspect=0.0.0.0:9229", "apps/panel/src/server/index.ts"]
