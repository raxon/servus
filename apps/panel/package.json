{
  "name": "@servus/panel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "PolyForm-Noncommercial-1.0.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4181 --strictPort",
    "dev:api": "cd ../.. && tsx watch apps/panel/src/server/index.ts",
    "agent": "cd ../.. && tsx apps/panel/src/agent/index.ts",
    "worker": "cd ../.. && tsx apps/panel/src/worker/index.ts",
    "build": "tsc -p tsconfig.server.json && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.server.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "start": "cd ../.. && node apps/panel/dist/server/index.js",
    "start:agent": "cd ../.. && node apps/panel/dist/agent/index.js",
    "start:worker": "cd ../.. && node apps/panel/dist/worker/index.js"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/rate-limit": "11.2.2",
    "@fastify/static": "10.1.11",
    "@fastify/websocket": "11.3.7",
    "@fontsource-variable/inter": "5.3.0",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-router": "1.170.46",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "better-sqlite3": "13.1.1",
    "dockerode": "5.0.1",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.8",
    "lucide-react": "1.72.0",
    "openid-client": "6.8.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "ws": "8.23.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/dockerode": "4.0.2",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.3.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
