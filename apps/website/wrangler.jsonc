{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "servus-website",
  "compatibility_date": "2026-11-13",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    { "pattern": "servus.run", "custom_domain": true }
  ]
}
