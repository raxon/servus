{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/scripts/install.sh", "$TURBO_ROOT$/scripts/prepare-website.mjs"],
      "outputs": ["dist/**"]
    },
    "typecheck": { "dependsOn": ["^typecheck"] },
    "test": { "cache": false },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["PANEL_*", "DOCKER_*", "VITE_*"]
    }
  }
}
