[Unit]
Description=Servus verified update coordinator
Requires=docker.service servus-supervisor.service servus-updater-socket.service
After=docker.service servus-supervisor.service servus-updater-socket.service
PartOf=docker.service

[Service]
Type=simple
User=root
Group=root
UMask=0077
EnvironmentFile=/etc/servus/updater.env
ExecStart=/usr/bin/python3 -I /usr/local/libexec/servus/servus-updater.py --state-dir ${SERVUS_UPDATER_STATE_DIR} --socket-dir ${SERVUS_UPDATER_SOCKET_DIR} --peer-uid ${SERVUS_COMPONENT_UID} --socket-gid ${SERVUS_UPDATER_SOCKET_GID} --supervisor-socket ${SERVUS_SUPERVISOR_COMMAND_SOCKET}
Restart=on-failure
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target docker.service
