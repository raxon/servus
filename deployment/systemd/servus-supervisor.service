[Unit]
Description=Servus host maintenance supervisor
Requires=docker.service
After=docker.service
PartOf=docker.service
Before=servus.service

[Service]
Type=simple
User=root
Group=root
UMask=0077
EnvironmentFile=/etc/servus/supervisor.env
# Optional SERVUS_SUPERVISOR_UPDATE_ARGS supplies --active-env and --apply-config from the root-owned environment file.
ExecStart=/usr/bin/python3 -I /usr/local/libexec/servus/supervisor-daemon.py --policy ${SERVUS_POLICY} --install-dir ${SERVUS_INSTALL_DIR} --gate-dir ${SERVUS_GATE_DIR} --journal-dir ${SERVUS_JOURNAL_DIR} --secret-dir ${SERVUS_SECRET_DIR} --socket-dir ${SERVUS_SOCKET_DIR} --approval-journal ${SERVUS_APPROVAL_JOURNAL} --accepted-env ${SERVUS_ACCEPTED_ENV} --uid ${SERVUS_COMPONENT_UID} --gid ${SERVUS_COMPONENT_GID} $SERVUS_SUPERVISOR_UPDATE_ARGS
Restart=on-failure
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
WantedBy=docker.service
