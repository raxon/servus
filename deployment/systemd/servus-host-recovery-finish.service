[Unit]
Description=Finish interrupted Servus host recovery
After=docker.service servus-updater-socket.service servus-supervisor.service servus-updater.service servus-host-recovery.service
Wants=servus-updater-socket.service servus-supervisor.service servus-updater.service
RequiresMountsFor=/var/lib/servus-updater /usr/local/libexec/servus /opt/servus

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/usr/bin/python3 -I /usr/local/libexec/servus/host-runner.py --recover-finish
NoNewPrivileges=true
TimeoutStartSec=180

[Install]
WantedBy=multi-user.target
