[Unit]
Description=Servus IP TLS proxy
After=network.target

[Service]
Type=forking
RuntimeDirectory=servus-ip-tls
RuntimeDirectoryMode=0755
PIDFile=/run/servus-ip-tls/nginx.pid
ExecStartPre=/usr/sbin/nginx -t -c /etc/servus-ip-tls/nginx.conf
ExecStart=/usr/sbin/nginx -c /etc/servus-ip-tls/nginx.conf
ExecReload=/usr/sbin/nginx -t -c /etc/servus-ip-tls/nginx.conf
ExecReload=/usr/sbin/nginx -s reload -c /etc/servus-ip-tls/nginx.conf
ExecStop=/usr/sbin/nginx -s quit -c /etc/servus-ip-tls/nginx.conf
Restart=on-failure

[Install]
WantedBy=multi-user.target
